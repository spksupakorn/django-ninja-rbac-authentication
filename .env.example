# Copy to .env for local commands, then change secrets before any shared deployment.
DATABASE_URL=postgresql://postgres:postgres@db:5432/rbac_auth
DJANGO_SECRET_KEY=change-this-to-a-different-long-random-secret-at-least-32-characters
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
ACCESS_TTL=15m
REFRESH_TTL=7d
DEFAULT_USER_ROLE=user
THROTTLE_LOGIN=5/minute
# Required when DJANGO_SETTINGS_MODULE=config.settings.prod. Comma-separated domains/IPs.
ALLOWED_HOSTS=example.com,www.example.com
DJANGO_SETTINGS_MODULE=config.settings.dev
